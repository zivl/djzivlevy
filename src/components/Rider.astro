---
import { rider } from '../data/rider';
import { t, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
type Item = (typeof rider.booth)[number] | (typeof rider.monitoring)[number];
const label = (i: Item) => ('gear' in i ? `${i.gear} ${d.rider.orHigher}` : d.rider.items[i.item]);
const groups = [
  { title: d.rider.booth, items: rider.booth },
  { title: d.rider.monitoring, items: rider.monitoring },
];
---

<section class="section" id="rider" aria-labelledby="rider-title">
  <h2 id="rider-title" class="section-title start">{d.sections.rider}</h2>
  <div class="groups">
    {
      groups.map((g) => (
        <div class="group">
          <h3>{g.title}</h3>
          <ul>
            {g.items.map((i) => (
              <li>{label(i)}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <p class="note">{d.rider.note}</p>
</section>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 16px;
  }

  .group {
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.03);
  }

  h3 {
    font-size: 1rem;
    margin-bottom: 10px;
  }

  ul {
    margin: 0;
    padding-inline-start: 1.1em;
    color: var(--muted);
  }

  li::marker {
    color: var(--pink);
  }

  li + li {
    margin-top: 4px;
  }

  .note {
    margin-top: 16px;
    color: var(--muted);
    font-style: italic;
    font-size: 0.92rem;
  }
</style>
