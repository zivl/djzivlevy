---
import { LOCALES, localizePath, t, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
  path: string;
}

const { lang, path } = Astro.props;
---

<nav class="langs" aria-label={t(lang).nav.language}>
  <ul>
    {
      LOCALES.map((l) => (
        <li>
          <a
            href={localizePath(path, l)}
            hreflang={l}
            lang={l}
            aria-current={l === lang ? 'page' : undefined}
            title={t(l).langName}
          >
            {l.toUpperCase()}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: inline-grid;
    place-items: center;
    min-width: 40px;
    min-height: 40px;
    padding: 0 8px;
    border-radius: var(--radius-sm);
    color: var(--dim);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.08);
  }

  a[aria-current='page'] {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--pink);
  }
</style>
