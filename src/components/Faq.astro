---
import { fill, t, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <h2 id="faq-title" class="section-title start">{d.sections.faq}</h2>
  <div class="faq">
    {
      d.faq.map(({ q, a }, i) => (
        <details open={i === 0}>
          <summary>
            <h3>{q}</h3>
          </summary>
          <p>{fill(a)}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: 10px;
  }

  details {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.03);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    flex: none;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--pink);
    transition: transform 0.2s ease;
  }

  details[open] summary::after {
    transform: rotate(45deg);
  }

  h3 {
    font-size: 0.98rem;
    font-weight: 600;
  }

  p {
    padding: 0 18px 18px;
    color: var(--muted);
  }
</style>
