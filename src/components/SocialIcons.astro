---
import { socials } from '../data/socials';
import Icon from './Icon.astro';
---

<ul class="socials" aria-label="Social links">
  {
    socials.map((s) => (
      <li>
        <a href={s.url} aria-label={s.label} title={s.label} rel="me noopener" target="_blank">
          <Icon name={s.id} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--text);
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  a:hover {
    background: rgb(255 255 255 / 0.12);
    transform: translateY(-2px);
  }

  a :global(svg) {
    width: 24px;
    height: 24px;
  }
</style>
