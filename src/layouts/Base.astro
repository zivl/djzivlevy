---
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { profile } from '../data/profile';
import { LOCALES, absoluteUrl, localizePath, t, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
  /** Unlocalized path of this page, e.g. '/' or '/epk'. */
  path: string;
  title: string;
  description: string;
  /** Root-relative OG image path (1200×630). */
  ogImage?: string;
  ogImageAlt?: string;
  /** Pre-serialized JSON-LD graph (see src/lib/jsonld.ts). */
  jsonld?: string;
  /** Emit hreflang alternates for all locales. */
  translated?: boolean;
  /** Root-relative path of this page's Markdown twin. */
  markdown?: string;
  noindex?: boolean;
}

const {
  lang,
  path,
  title,
  description,
  ogImage = '/og/home.jpg',
  ogImageAlt = profile.name,
  jsonld,
  translated = true,
  markdown,
  noindex = false,
} = Astro.props;

const d = t(lang);
const canonical = absoluteUrl(translated ? localizePath(path, lang) : path);
const ogImageUrl = absoluteUrl(ogImage);
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#05001e" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {
      translated &&
        LOCALES.map((l) => <link rel="alternate" hreflang={l} href={absoluteUrl(localizePath(path, l))} />)
    }
    {translated && <link rel="alternate" hreflang="x-default" href={absoluteUrl(path)} />}
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="Markdown version for AI agents" />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={d.ogLocale} />
    {
      translated &&
        LOCALES.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={t(l).ogLocale} />)
    }
    <meta property="profile:first_name" content={profile.givenName} />
    <meta property="profile:last_name" content={profile.familyName} />
    <meta property="profile:username" content={profile.contact.instagramHandle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonld && <script is:inline type="application/ld+json" set:html={jsonld} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{d.nav.skip}</a>
    <slot />
    <Analytics />
    {/* the component reports the build file name ('/epk.html') as the page; use the real URL instead. Must run before its (deferred) module script */}
    <script is:inline>
      document.querySelector('vercel-analytics')?.setAttribute('data-pathname', location.pathname);
    </script>
    {/* group by page template (e.g. '/epk' for all languages); the default would use the build file name '/epk.html' */}
    <SpeedInsights route={path} />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
