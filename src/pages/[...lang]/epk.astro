---
import { Picture } from 'astro:assets';
import heroBooth from '../../assets/hero-booth.jpg';
import Booking from '../../components/Booking.astro';
import Faq from '../../components/Faq.astro';
import Footer from '../../components/Footer.astro';
import Gallery from '../../components/Gallery.astro';
import Gigs from '../../components/Gigs.astro';
import Icon from '../../components/Icon.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import MusicSection from '../../components/MusicSection.astro';
import PressAssets from '../../components/PressAssets.astro';
import Rider from '../../components/Rider.astro';
import VideoGrid from '../../components/VideoGrid.astro';
import { upcomingGigs } from '../../data/gigs';
import { profile } from '../../data/profile';
import { videos } from '../../data/videos';
import { absoluteUrl, localeStaticPaths, localizePath, markdownPath, t, type Locale } from '../../i18n/utils';
import Base from '../../layouts/Base.astro';
import { artistNode, breadcrumbNode, eventNode, faqNode, graph, videoNode, webPageNode, websiteNode } from '../../lib/jsonld';

export const getStaticPaths = localeStaticPaths;

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const path = '/epk';
const featured = videos.filter((v) => v.featured);
const ogImage = absoluteUrl('/og/epk.jpg');

const jsonld = graph([
  websiteNode(lang),
  webPageNode({ lang, path, title: d.meta.epk.title, description: d.meta.epk.description, breadcrumb: true }),
  breadcrumbNode(lang, path, d.cta.pressKit),
  artistNode(lang, absoluteUrl('/og/portrait.jpg')),
  ...featured.map(videoNode),
  ...upcomingGigs().map((g) => eventNode(g, ogImage)),
  faqNode(lang, path),
]);
---

<Base
  lang={lang}
  path={path}
  title={d.meta.epk.title}
  description={d.meta.epk.description}
  ogImage="/og/epk.jpg"
  ogImageAlt={`${profile.name} – ${d.cta.pressKit}`}
  jsonld={jsonld}
  markdown={markdownPath(path, lang)}
>
  <header class="topbar">
    <a class="back" href={localizePath('/', lang)}>
      <Icon name="arrowLeft" />
      {d.nav.links}
    </a>
    <LanguageSwitcher lang={lang} path={path} />
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="epk-title">
      <Picture
        src={heroBooth}
        alt={d.gallery.alts.booth}
        formats={['avif', 'webp']}
        widths={[640, 1080, 1600]}
        sizes="(max-width: 1120px) 100vw, 1080px"
        priority
        class="hero-img"
      />
      <div class="hero-text">
        <p class="eyebrow">{d.cta.pressKit}</p>
        <h1 id="epk-title">{profile.name}</h1>
        <p class="genres">{profile.epkGenres.join(' / ')}</p>
        <a class="btn btn-primary" href="#booking">{d.cta.book}</a>
      </div>
    </section>

    <div class="wrap">
      <section class="section about" id="about" aria-labelledby="about-title">
        <h2 id="about-title" class="section-title start">{d.sections.vibe}</h2>
        <p class="bio">{d.bio}</p>
        <p class="intro">{d.intro}</p>
      </section>

      <section class="section" id="featured" aria-labelledby="featured-title">
        <h2 id="featured-title" class="section-title start">{d.sections.featured}</h2>
        <VideoGrid videos={featured} lang={lang} columns={3} />
      </section>

      <MusicSection lang={lang} alignStart />
      <Gigs lang={lang} includePast alignStart />
      <Gallery lang={lang} />
      <Rider lang={lang} />
      <PressAssets lang={lang} />
      <Faq lang={lang} />
      <Booking lang={lang} />
    </div>
  </main>

  <Footer lang={lang} />
</Base>

<style>
  .topbar {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px var(--gutter);
    background: rgb(5 0 30 / 0.82);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .back :global(svg) {
    width: 18px;
    height: 18px;
  }

  .hero {
    position: relative;
    isolation: isolate;
    max-width: 1080px;
    margin: clamp(0px, 3vw, 28px) auto 0;
    min-height: clamp(380px, 56vw, 560px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  @media (min-width: 1120px) {
    .hero {
      border-radius: var(--radius);
    }
  }

  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(5 0 30 / 0.1) 20%, rgb(5 0 30 / 0.92) 85%);
  }

  .hero-text {
    display: grid;
    justify-items: start;
    gap: 10px;
    padding: 32px var(--gutter);
  }

  .eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pink);
  }

  h1 {
    font-size: clamp(2.2rem, 7vw, 3.8rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .genres {
    color: var(--muted);
    font-size: clamp(0.95rem, 2.2vw, 1.1rem);
    margin-bottom: 8px;
  }

  .wrap {
    max-width: 1080px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .about {
    border-top: 0;
  }

  .bio {
    font-size: clamp(1.05rem, 2.4vw, 1.25rem);
    line-height: 1.65;
    max-width: 62ch;
  }

  .intro {
    margin-top: 14px;
    color: var(--muted);
    max-width: 62ch;
  }
</style>
